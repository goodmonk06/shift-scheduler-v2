# ---- Core ----
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-super-secret
DATABASE_URL=

# ---- LLM ----
LLM_PROVIDER=openai   # openai | anthropic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---- OAuth (任意。使わないなら空のまま) ----
OAUTH_SERVER_URL=

# ---- Storage (S3/R2) ----
AWS_REGION=auto
S3_BUCKET=
S3_ENDPOINT=           # R2なら https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Notifications ----
RESEND_API_KEY=        # or SMTP_* を使う
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# ---- Web Push (任意) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Observability (任意) ----
SENTRY_DSN=
